{
  "name": "orcid-utils",
  "version": "0.0.1",
  "description": "Validates and formats ORCID numbers",
  "license": "MIT",
  "workspaces": [
    "lib",
    "src"
  ],
  "scripts": {
    "src:build": "tsc --project src/tsconfig.json && rm lib/tsconfig.tsbuildinfo",
    "src:minify": "esbuild src/orcid.ts --minify --sourcemap --format=cjs --outfile=lib/orcid.min.js --target=chrome90,edge91,firefox89,ios14.0,safari14,node12 --analyze",
    "src:test": "vitest run",
    "src:test:watch": "vitest watch",
    "update:npm": "npm-update",
    "update:actions": "actions-up"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "actions-up": "1.21.0",
    "esbuild": "0.28.2",
    "npm-updater": "3.0.3",
    "prettier": "3.9.9",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
